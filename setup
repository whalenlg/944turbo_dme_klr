# shellcheck shell=bash
# ============================================================
#  setup — per-terminal environment for this checkout
#
#  Usage:  source setup        (from anywhere: source /path/to/checkout/setup)
#
#  - sets DMEKLR_REPO and DMEKLR_TMP (paths.sh); set DMEKLR_TMP before
#    sourcing this to put the build output and logs somewhere else
#  - activates the Python venv 944venv/ when it exists (install_macos.sh
#    makes it; install_arch.sh and install_msys2.sh with --venv)
#  - on Windows, use it in an MSYS2 UCRT64 terminal; DMEKLR_REPO and
#    DMEKLR_TMP are then C:/... paths, which the native tools understand
#  - puts a locally built Icarus Verilog in /opt/iverilog, and a GTKWave
#    in <checkout>/gtkwave/bin (install_macos.sh builds it there) or
#    <checkout>/gtkwave, ahead of the system ones when they exist
#  - adds the checkout to PATH
# ============================================================

if [ -n "${BASH_SOURCE[0]:-}" ]; then _dmeklr_here="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then eval '_dmeklr_here="${(%):-%x}"'
else _dmeklr_here="$0"; fi
source "$(cd "$(dirname "$_dmeklr_here")" && pwd)/paths.sh"

if [ -d /opt/iverilog/bin ]; then
    export PATH="/opt/iverilog/bin:$PATH"
    export IVERILOG_VPI_MODULE_PATH=/opt/iverilog/lib
fi
if [ -x "$DMEKLR_REPO/gtkwave/bin/gtkwave" ]; then export PATH="$DMEKLR_REPO/gtkwave/bin:$PATH"
elif [ -d "$DMEKLR_REPO/gtkwave" ]; then export PATH="$DMEKLR_REPO/gtkwave:$PATH"; fi
export IVERILOG_DUMPER=fst

if [ -f "$DMEKLR_REPO/944venv/bin/activate" ]; then source "$DMEKLR_REPO/944venv/bin/activate"
elif [ -f "$DMEKLR_REPO/944venv/Scripts/activate" ]; then source "$DMEKLR_REPO/944venv/Scripts/activate"; fi

# PATH is colon-separated, so on Windows (MSYS2) it takes the /c/... form
_dmeklr_pathdir="$DMEKLR_REPO"
command -v cygpath >/dev/null 2>&1 && _dmeklr_pathdir="$(cygpath -u "$DMEKLR_REPO")"
case ":$PATH:" in *":$_dmeklr_pathdir:"*) ;; *) export PATH="$PATH:$_dmeklr_pathdir" ;; esac
unset _dmeklr_here _dmeklr_pathdir
